# Oshiire configuration. Copy this file to `.env` and fill in the values.
#
# ############################################################################
# #  WARNING -- `.env` CARRIES A SECRET. NEVER COMMIT OR SHARE IT.           #
# #                                                                          #
# #  REDDIT_SAVED_FEED_URL contains a per-account access token. Anyone who   #
# #  has that URL can read your entire saved list without logging in. Treat  #
# #  it exactly like a password: do not commit it, do not paste it into an   #
# #  issue, a chat, a screenshot, or a bug report, and do not let it into a  #
# #  log file.                                                               #
# #                                                                          #
# #  `.env` is gitignored, and this file (`.env.example`) is the only one    #
# #  of the pair that is committed -- keep it that way, and keep the value   #
# #  below EMPTY.                                                            #
# #                                                                          #
# #  If the token does leak: change your Reddit password. That invalidates   #
# #  the feed URL (and is also why the URL stops working after any password  #
# #  change -- you then re-copy the new one from the page below).            #
# ############################################################################

# Your private Reddit saved-posts RSS feed.
#
# Where to find it: log in to Reddit, go to https://old.reddit.com/prefs/feeds/
# and copy the RSS link next to "your saved links". It looks like
#   https://old.reddit.com/saved.rss?feed=<64-hex-token>&user=<your-username>
# The `feed=` parameter is the secret token.
#
# The feed returns roughly your 25 most recent saves. Appending `&limit=100`
# widens that to ~100, which is the practical maximum -- there is no
# pagination, so anything older than the window is unreachable from the feed.
# (Getting at older saves is what the backfill subsystem is for; see
# docs/BACKFILL.md.)
#
# This feed is READ-ONLY. Oshiire cannot unsave, vote, or write anything back
# to your account through it.
REDDIT_SAVED_FEED_URL=

# The root folder of your sorted archive -- where approved images are filed.
#
# It does NOT have to be an existing, organized archive: point it at an empty
# folder and the first `--apply` run creates the subfolders it needs. It can be
# a cloud-synced folder (Google Drive, OneDrive, Dropbox); Oshiire only ever
# moves files into it and lets the sync client do the upload. Use an absolute
# path. On Windows, either forward slashes or doubled backslashes are fine:
#   ARCHIVE_DIR=C:/Users/you/Google Drive/Art
ARCHIVE_DIR=

# Optional. Included in the User-Agent header of every request to Reddit, per
# Reddit's API etiquette guidelines, so a human is identifiable if a request
# pattern ever looks wrong. Not a secret -- it is your public username. Leave
# it blank to send a generic, non-identifying value instead.
REDDIT_USERNAME=
