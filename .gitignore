# === Oshiire: secrets & personal data — MUST stay out of git ===

# Reddit API credentials and any other secrets.
# These never get committed. Losing this line = burned secret.
.env
.env.*
*.secret
praw.ini

# Personal data derived from YOUR Reddit account.
# The manifest holds your saved-post titles/URLs; the folders hold your images.
# None of this belongs in a remote, even a private one.
staging/
archive/
manifest.json
*.manifest.json

# Personal archive layout (describes YOUR whole collection). Templates are
# committed; the real ones are yours and stay local.
layout.json
layout copy.json
000___Known_Series_Names.txt
known_series_names.txt
!layout.example.json
!known_series_names.example.txt

# AI model weights — large binaries, don't want them in git regardless.
*.onnx
*.pt
*.pth
models/

# === Standard Python ===
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/


# === OS / editor cruft ===
.DS_Store
Thumbs.db
.idea/
.vscode/